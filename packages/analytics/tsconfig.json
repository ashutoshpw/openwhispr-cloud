{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "..",
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@repo/database": ["../database/src"],
      "@repo/database/*": ["../database/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
