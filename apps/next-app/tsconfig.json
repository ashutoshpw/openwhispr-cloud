{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "skipLibCheck": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@repo/database": ["../../packages/database/src"],
      "@repo/database/*": ["../../packages/database/src/*"],
      "@repo/auth": ["../../packages/auth/src"],
      "@repo/auth/*": ["../../packages/auth/src/*"],
      "@repo/billing": ["../../packages/billing/src"],
      "@repo/billing/*": ["../../packages/billing/src/*"],
      "@repo/fumadocs": ["../../packages/fumadocs/src"],
      "@repo/fumadocs/*": ["../../packages/fumadocs/src/*"],
      "@repo/mcp-server": ["../../packages/mcp-server/src"],
      "@repo/mcp-server/*": ["../../packages/mcp-server/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "bcryptjs.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".source/**/*.ts",
    ".source/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
