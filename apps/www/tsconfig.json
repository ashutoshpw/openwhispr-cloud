{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@repo/database": ["../../packages/database/src"],
      "@repo/database/*": ["../../packages/database/src/*"],
      "@repo/analytics": ["../../packages/analytics/src"],
      "@repo/analytics/client": [
        "../../packages/analytics/src/client-entry.ts"
      ],
      "@repo/analytics/*": ["../../packages/analytics/src/*"],
      "@repo/auth": ["../../packages/auth/src"],
      "@repo/auth/*": ["../../packages/auth/src/*"],
      "@repo/billing": ["../../packages/billing/src"],
      "@repo/billing/*": ["../../packages/billing/src/*"],
      "@repo/fumadocs": ["../../packages/fumadocs/src"],
      "@repo/fumadocs/*": ["../../packages/fumadocs/src/*"],
      "@repo/ui": ["../../packages/ui/src"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "@repo/api-schemas": ["../../packages/api-schemas/src"],
      "@repo/api-schemas/*": ["../../packages/api-schemas/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "bcryptjs.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".source/**/*.ts",
    ".source/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
