{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@repo/auth": ["../../packages/auth/src"],
      "@repo/auth/*": ["../../packages/auth/src/*"],
      "@repo/database": ["../../packages/database/src"],
      "@repo/database/*": ["../../packages/database/src/*"],
      "@repo/analytics": ["../../packages/analytics/src"],
      "@repo/analytics/*": ["../../packages/analytics/src/*"],
      "@repo/billing": ["../../packages/billing/src"],
      "@repo/billing/*": ["../../packages/billing/src/*"],
      "@repo/ui": ["../../packages/ui/src"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "@repo/ai": ["../../packages/ai/src"],
      "@repo/ai/*": ["../../packages/ai/src/*"],
      "@repo/durable-exec": ["../../packages/durable-exec/src"],
      "@repo/durable-exec/*": ["../../packages/durable-exec/src/*"],
      "@repo/object-storage": ["../../packages/object-storage/src"],
      "@repo/object-storage/*": ["../../packages/object-storage/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
