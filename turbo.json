{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_AUTH_PROVIDER",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "INNGEST_DEV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_AUTH_PROVIDER",
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "INNGEST_DEV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_AUTH_PROVIDER",
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "INNGEST_DEV"
      ]
    },
    "start": {
      "dependsOn": ["build"]
    },
    "lint": {},
    "lint:fix": {},
    "format": {},
    "format:check": {},
    "db:generate": {},
    "db:migrate": {},
    "db:push": {},
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
