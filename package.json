{
  "name": "nextjs-starter-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:studio": "bun run --filter @repo/database db:studio",
    "db:seed": "bun run scripts/seed-admin.ts",
    "init-auth": "bun run scripts/init-auth.ts",
    "setup": "bun run scripts/setup.ts",
    "setup:stripe": "bun run scripts/setup-stripe.ts",
    "setup:posthog": "bun run scripts/setup-posthog.ts",
    "setup:referral": "bun run scripts/setup-referral.ts",
    "stripe:verify": "node scripts/verify-stripe-keys.js",
    "stripe:migrate": "bun run scripts/migrate-stripe-schema.ts",
    "stripe:backfill": "bun run scripts/backfill-stripe-data.ts",
    "posthog:test-event": "bun run scripts/test-posthog-event.ts",
    "posthog:test-workflow": "bun run scripts/test-posthog-workflow.ts",
    "check:max-lines": "bun run scripts/check-max-lines.ts",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@inquirer/prompts": "^8.2.0",
    "dotenv": "^17.2.3",
    "posthog-node": "^5.24.15",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "latest"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check:max-lines"
  }
}
