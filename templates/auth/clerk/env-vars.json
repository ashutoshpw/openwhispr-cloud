{
  "provider": "clerk",
  "displayName": "Clerk",
  "description": "Modern authentication with hosted UI, user management, and social logins",
  "required": [
    {
      "key": "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
      "description": "Clerk publishable key (from Clerk Dashboard)",
      "secret": false
    },
    {
      "key": "CLERK_SECRET_KEY",
      "description": "Clerk secret key (from Clerk Dashboard)",
      "secret": true
    }
  ],
  "optional": [
    {
      "key": "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
      "description": "Custom sign-in page URL",
      "default": "/sign-in"
    },
    {
      "key": "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
      "description": "Custom sign-up page URL",
      "default": "/sign-up"
    },
    {
      "key": "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL",
      "description": "Redirect URL after sign-in",
      "default": "/dashboard"
    },
    {
      "key": "NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL",
      "description": "Redirect URL after sign-up",
      "default": "/onboarding"
    }
  ],
  "groups": {},
  "databaseTables": ["user", "session", "account"],
  "externalAuth": true,
  "setupUrl": "https://dashboard.clerk.com",
  "notes": "Clerk handles user authentication externally. Local user/session/account tables are used for syncing Clerk users to local database for organization membership and billing features."
}
