{
  "provider": "better-auth",
  "displayName": "Better Auth",
  "description": "Modern, self-hosted authentication with built-in email/password and OAuth support",
  "required": [
    {
      "key": "BETTER_AUTH_SECRET",
      "description": "Secret key for Better Auth sessions (auto-generated)",
      "generate": true,
      "generator": "base64-32"
    },
    {
      "key": "BETTER_AUTH_URL",
      "description": "Base URL for Better Auth API",
      "default": "${NEXT_PUBLIC_APP_URL}"
    }
  ],
  "optional": [
    {
      "key": "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
      "description": "Google OAuth client ID",
      "group": "google-oauth"
    },
    {
      "key": "GOOGLE_CLIENT_SECRET",
      "description": "Google OAuth client secret",
      "group": "google-oauth",
      "secret": true
    }
  ],
  "groups": {
    "google-oauth": {
      "name": "Google OAuth",
      "description": "Enable Sign in with Google",
      "setupUrl": "https://console.cloud.google.com/apis/credentials"
    }
  },
  "databaseTables": ["user", "session", "account", "verification"]
}
