# ============================================
# REQUIRED - Database
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextjs_starter

# ============================================
# REQUIRED - Authentication Provider
# Choose ONE provider and configure the corresponding variables below
# ============================================

# Set this to one of: better-auth, next-auth, authkit, clerk-dev
AUTH_PROVIDER=better-auth

# Base URL for the application (required for all providers)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# BetterAuth Configuration
# Required if AUTH_PROVIDER=better-auth
# Generate secret with: openssl rand -base64 32
# ============================================
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# ============================================
# NextAuth (Auth.js v5) Configuration
# Required if AUTH_PROVIDER=next-auth
# Generate secret with: openssl rand -base64 32
# ============================================
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:8801

# ============================================
# AuthKit (WorkOS) Configuration
# Required if AUTH_PROVIDER=authkit
# Get credentials from: https://workos.com
# Generate cookie password with: openssl rand -base64 32
# ============================================
WORKOS_API_KEY=sk_xxx
WORKOS_CLIENT_ID=client_xxx
WORKOS_COOKIE_PASSWORD=your-complex-password-at-least-32-characters-long
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:8801/api/auth/callback

# ============================================
# Clerk Configuration
# Required if AUTH_PROVIDER=clerk-dev
# Get credentials from: https://clerk.com
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ============================================
# OPTIONAL - Stripe Payments
# ============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (client-side) — required for inline card collection in
# the "Create Workspace" flow.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================
# OPTIONAL - Upstash Redis (Rate Limiting & Caching)
# Get credentials from: https://upstash.com
# ============================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# OPTIONAL - Email Provider (Resend)
# If not configured, password reset codes will print to console
# Get API key from: https://resend.com
# ============================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Your App

# ============================================
# OPTIONAL - Admin Configuration
# ============================================

# Auto-promote users from these email domains to site-admin role
# Comma-separated list (e.g., mycompany.com,team.io)
ADMIN_EMAIL_DOMAINS=

# Initial admin user credentials (created via 'bun run db:seed')
# Configure these via 'bun run setup' or set manually
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ============================================
# OPTIONAL - Integrations
# ============================================

# AES-256-GCM key for encrypting integration credentials.
# Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# ============================================
# OPTIONAL - Passkey (WebAuthn)
# ============================================

# Relying-Party ID for passkey registration/authentication.
# Defaults to "localhost" when unset. In production set to the apex domain
# users sign in from (e.g. example.com or app.example.com). Must match the
# eTLD+1 of BETTER_AUTH_URL / NEXT_PUBLIC_APP_URL.
PASSKEY_RP_ID=

# ============================================
# OPTIONAL - OAuth Providers
# ============================================

# Google sign-in. The public client id is used to gate the "Continue with
# Google" button on the sign-in page; both must be set to enable Google auth.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in. Both must be set to enable the GitHub provider.
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# SEO / AIEO — rank tracking + AI engine visibility
# ============================================

# Target domain the SEO + AIEO modules track (e.g. example.com).
SEO_TARGET_DOMAIN=
SEO_TARGET_COUNTRY=US

# DataForSEO SERP API — pre-built Basic auth header value.
# Generate locally: echo -n 'login:password' | base64 → paste as "Basic <b64>".
DATAFORSEO_AUTH=
DATAFORSEO_SERP_BASE_URL=https://api.dataforseo.com

# Google Search Console — base64-encoded service-account JSON.
# Add the SA as a verified user on your GSC property.
GSC_SERVICE_ACCOUNT_JSON=
# e.g. sc-domain:example.com  or  https://example.com/
GSC_PROPERTY=

# Inngest — local dev uses the inngest CLI; production requires signing keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set INNGEST_DEV=1 and point BASE_URL to the local CLI when running locally.
# Leave both unset (or empty) in production.
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288

# AIEO — secret-store master key (32-byte hex).
# Generate: openssl rand -hex 32
AIEO_ENCRYPTION_KEY=

# AIEO — fallback provider keys (vault in /adminx/seo/aieo/secrets takes precedence).
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# @repo/ai — OpenAI-compatible gateway settings (used by packages/ai).
# OPENAI_BASE_URL can point to any OpenAI-compatible endpoint (e.g. Azure, local proxy).
OPENAI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o-mini

# CRON_SECRET — bearer token for /api/aieo/bot-hit and any protected cron routes.
CRON_SECRET=
