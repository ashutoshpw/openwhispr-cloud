{
  "provider": "next-auth",
  "displayName": "NextAuth.js",
  "description": "Authentication for Next.js with built-in OAuth providers and database adapters",
  "required": [
    {
      "key": "NEXTAUTH_SECRET",
      "description": "Secret key for NextAuth sessions (auto-generated)",
      "generate": true,
      "generator": "base64-32"
    },
    {
      "key": "NEXTAUTH_URL",
      "description": "Base URL for NextAuth API (required in production)",
      "default": "${NEXT_PUBLIC_APP_URL}"
    }
  ],
  "optional": [
    {
      "key": "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
      "description": "Google OAuth client ID",
      "group": "google-oauth"
    },
    {
      "key": "GOOGLE_CLIENT_SECRET",
      "description": "Google OAuth client secret",
      "group": "google-oauth",
      "secret": true
    }
  ],
  "groups": {
    "google-oauth": {
      "name": "Google OAuth",
      "description": "Enable Sign in with Google",
      "setupUrl": "https://console.cloud.google.com/apis/credentials"
    }
  },
  "databaseTables": ["user", "session", "account", "verification"]
}
